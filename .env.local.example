# Site URL
NEXT_PUBLIC_SITE_URL=https://solomonelijah.online

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated, confirmed Supabase account email addresses permitted to administer this site.
# Alternatively set app_metadata.role=admin through trusted Supabase administration.
ADMIN_EMAILS=

# -------------------------------------------------------------
# Email Configuration (SMTP)
# -------------------------------------------------------------
# Option 1: Resend SMTP (https://resend.com/docs/send-with-smtp)
# Host: smtp.resend.com
# Port: 465 (SSL) or 587 (TLS), or 2465 / 2587
# User: resend
# Password: <your_resend_api_key starting with re_>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_your_api_key_here
SMTP_FROM=Solomon Elijah <onboarding@resend.dev>

# Target email that receives instant alerts when visitors send a message:
ADMIN_NOTIFICATION_EMAIL=solomonelijahsunday1@gmail.com

# Option 2: Generic SMTP (e.g. Gmail App Password, Zoho, cPanel, Mailgun)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_app_password
# SMTP_FROM=Solomon Elijah <your_email@gmail.com>

# Legacy / Alternative Resend REST API keys:
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

